{
  "displayName": "Supla Plugin",
  "name": "@marcel2215/homebridge-supla-plugin",
  "version": "2.1.33",
  "description": "Plugin for Homebridge to control Supla devices",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kamilolek/HomebridgeSuplaPlugin.git"
  },
  "engines": {
    "node": "^18.17.0 || ^20.9.0 || ^22.12.0 || ^24.0.0",
    "homebridge": "^1.6.0 || ^2.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build",
    "version:bump:major": "npm version major",
    "version:bump:minor": "npm version minor",
    "version:bump:revision": "npm version patch",
    "publish:plugin": "bash ./scripts/publish.sh",
    "publish:plugin:dry-run": "bash ./scripts/publish.sh --dry-run"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "supla"
  ],
  "dependencies": {
    "mqtt": "^5.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.45.0",
    "homebridge": "2.1.1",
    "nodemon": "^2.0.22",
    "rimraf": "^3.0.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3"
  }
}
