{
  "pluginAlias": "SuplaPlatform",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "name": {
      "title": "Name",
      "type": "string",
      "default": "Supla"
    },
    "host": {
      "title": "Host",
      "type": "string",
      "default": "mqtt24.supla.org"
    },
    "port": {
        "title": "Port",
        "type": "number",
        "default": 8883
    },
    "protocol": {
      "title": "Protocol",
      "type": "string",
      "default": "mqtt"
    },
    "tls": {
      "title": "TLS",
      "type": "boolean",
      "default": true
    },
    "tlsCaPath": {
      "title": "TLS CA Path",
      "type": "string",
      "default": ""
    },
    "tlsRejectUnauthorized": {
      "title": "TLS Reject Unauthorized",
      "type": "boolean",
      "default": true
    },
    "tlsServername": {
      "title": "TLS Servername (SNI)",
      "type": "string",
      "default": ""
    },
    "includeHidden": {
      "title": "Include Hidden Channels",
      "type": "boolean",
      "default": false
    },
    "mqttTopicScheme": {
      "title": "MQTT Topic Scheme",
      "type": "string",
      "default": "cloud",
      "enum": [
        "cloud",
        "legacy",
        "auto"
      ]
    },
    "coveringControlMode": {
      "title": "Covering Control Mode",
      "type": "string",
      "default": "set",
      "enum": [
        "set",
        "execute_action",
        "hybrid"
      ]
    },
    "coveringSetTopicSuffix": {
      "title": "Covering Set Topic Suffix",
      "type": "string",
      "default": "set/closing_percentage"
    },
    "coveringTiltTopicSuffix": {
      "title": "Covering Tilt Topic Suffix",
      "type": "string",
      "default": "set/tilt"
    },
    "coveringExecuteActionOpen": {
      "title": "Covering Execute Action Open",
      "type": "string",
      "default": "reveal"
    },
    "coveringExecuteActionClose": {
      "title": "Covering Execute Action Close",
      "type": "string",
      "default": "shut"
    },
    "coveringExecuteActionStop": {
      "title": "Covering Execute Action Stop",
      "type": "string",
      "default": "stop"
    },
    "coveringTravelTimeSeconds": {
      "title": "Covering Travel Time Seconds",
      "type": "number",
      "default": 0
    },
    "username": {
      "title": "Username",
      "type": "string",
      "default": "admin"
    },
    "password": {
      "title": "Password",
      "type": "string",
      "default": "admin"
    },
    "channels": {
      "title": "Cached Channels",
      "type": "string",
      "default": "[]"
    }
  }
}
