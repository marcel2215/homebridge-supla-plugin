{
  "pluginAlias": "SuplaPlatform",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "name": {
      "title": "Name",
      "type": "string",
      "default": "Supla"
    },
    "host": {
      "title": "Host",
      "type": "string",
      "default": "mqtt24.supla.org"
    },
    "port": {
        "title": "Port",
        "type": "number",
        "default": 8883
    },
    "protocol": {
      "title": "Protocol",
      "type": "string",
      "default": "mqtt"
    },
    "tls": {
      "title": "TLS",
      "type": "boolean",
      "default": true
    },
    "tlsCaPath": {
      "title": "TLS CA Path",
      "type": "string",
      "default": ""
    },
    "tlsRejectUnauthorized": {
      "title": "TLS Reject Unauthorized",
      "type": "boolean",
      "default": true
    },
    "tlsServername": {
      "title": "TLS Servername (SNI)",
      "type": "string",
      "default": ""
    },
    "includeHidden": {
      "title": "Include Hidden Channels",
      "type": "boolean",
      "default": false
    },
    "mqttTopicScheme": {
      "title": "MQTT Topic Scheme",
      "type": "string",
      "default": "cloud",
      "enum": [
        "cloud",
        "legacy",
        "auto"
      ]
    },
    "gateControlMode": {
      "title": "Gate Control Mode",
      "type": "string",
      "default": "execute_action",
      "enum": [
        "execute_action",
        "toggle"
      ]
    },
    "gateExecuteActionOpen": {
      "title": "Gate Execute Action Open",
      "type": "string",
      "default": "open"
    },
    "gateExecuteActionClose": {
      "title": "Gate Execute Action Close",
      "type": "string",
      "default": "close"
    },
    "gateExecuteActionToggle": {
      "title": "Gate Execute Action Toggle",
      "type": "string",
      "default": "toggle"
    },
    "gatePartialHiMode": {
      "title": "Gate Partial Hi Mode",
      "type": "string",
      "default": "moving",
      "enum": [
        "moving",
        "open_endstop",
        "pedestrian_endstop",
        "ignore"
      ]
    },
    "gateLockControlMode": {
      "title": "Gate Lock Control Mode",
      "type": "string",
      "default": "execute_action",
      "enum": [
        "execute_action",
        "set_on_pulse"
      ]
    },
    "gateLockExecuteAction": {
      "title": "Gate Lock Execute Action",
      "type": "string",
      "default": "open"
    },
    "gateLockSetTopicSuffix": {
      "title": "Gate Lock Set Topic Suffix",
      "type": "string",
      "default": "set/on"
    },
    "gateLockPulseSeconds": {
      "title": "Gate Lock Pulse Seconds",
      "type": "number",
      "default": 0
    },
    "gateLockSetOnPayload": {
      "title": "Gate Lock Set On Payload",
      "type": "string",
      "default": "true"
    },
    "gateLockSetOffPayload": {
      "title": "Gate Lock Set Off Payload",
      "type": "string",
      "default": "false"
    },
    "coveringControlMode": {
      "title": "Covering Control Mode",
      "type": "string",
      "default": "set",
      "enum": [
        "set",
        "execute_action",
        "hybrid"
      ]
    },
    "coveringSetTopicSuffix": {
      "title": "Covering Set Topic Suffix",
      "type": "string",
      "default": "set/closing_percentage"
    },
    "coveringTiltTopicSuffix": {
      "title": "Covering Tilt Topic Suffix",
      "type": "string",
      "default": "set/tilt"
    },
    "coveringExecuteActionOpen": {
      "title": "Covering Execute Action Open",
      "type": "string",
      "default": "reveal"
    },
    "coveringExecuteActionClose": {
      "title": "Covering Execute Action Close",
      "type": "string",
      "default": "shut"
    },
    "coveringExecuteActionStop": {
      "title": "Covering Execute Action Stop",
      "type": "string",
      "default": "stop"
    },
    "coveringTravelTimeSeconds": {
      "title": "Covering Travel Time Seconds",
      "type": "number",
      "default": 0
    },
    "commandQos": {
      "title": "Command QoS",
      "type": "number",
      "default": 0,
      "enum": [
        0,
        1,
        2
      ]
    },
    "commandRetain": {
      "title": "Command Retain",
      "type": "boolean",
      "default": false
    },
    "username": {
      "title": "Username",
      "type": "string",
      "default": "admin"
    },
    "password": {
      "title": "Password",
      "type": "string",
      "default": "admin"
    },
    "channels": {
      "title": "Cached Channels",
      "type": "string",
      "default": "[]"
    }
  }
}
