{
  "pluginAlias": "SuplaPlatform",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "name": {
      "title": "Name",
      "type": "string",
      "default": "Supla"
    },
    "host": {
      "title": "Host",
      "type": "string",
      "default": "mqtt24.supla.org"
    },
    "port": {
        "title": "Port",
        "type": "number",
        "default": 8883
    },
    "protocol": {
      "title": "Protocol",
      "type": "string",
      "default": "mqtt"
    },
    "tls": {
      "title": "TLS",
      "type": "boolean",
      "default": true
    },
    "includeHidden": {
      "title": "Include Hidden Channels",
      "type": "boolean",
      "default": false
    },
    "coveringControlMode": {
      "title": "Covering Control Mode",
      "type": "string",
      "default": "set",
      "enum": [
        "set",
        "execute_action",
        "hybrid"
      ]
    },
    "coveringSetTopicSuffix": {
      "title": "Covering Set Topic Suffix",
      "type": "string",
      "default": "set/shut"
    },
    "coveringTiltTopicSuffix": {
      "title": "Covering Tilt Topic Suffix",
      "type": "string",
      "default": "set/tilt"
    },
    "username": {
      "title": "Username",
      "type": "string",
      "default": "admin"
    },
    "password": {
      "title": "Password",
      "type": "string",
      "default": "admin"
    },
    "channels": {
      "title": "Cached Channels",
      "type": "string",
      "default": "[]"
    }
  }
}
